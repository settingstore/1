rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Imágenes de producto subidas desde el panel admin. Lectura
    // pública (la tienda las muestra sin login). Solo el admin
    // logueado puede subir o borrar, y se limita el tamaño a 5MB
    // y a archivos de tipo imagen para evitar usos indebidos.
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
