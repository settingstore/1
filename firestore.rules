rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Devuelve settings/resellerAccess ({ code, allowedPhones, ... }).
    // Se usa para validar, del lado del servidor (no solo en el
    // JavaScript de la página), que quien crea una sesión de
    // revendedor tiene el código correcto Y, si hay una lista de
    // teléfonos autorizados cargada, que su teléfono esté en esa
    // lista. Así, aunque alguien copie el código o el JS de la
    // página, Firestore va a rechazar la sesión igual si su número
    // no está en la lista.
    function resellerAccessData() {
      return get(/databases/$(database)/documents/settings/resellerAccess).data;
    }

    // Documentos de configuración (código de acceso de revendedores,
    // datos de pago/alias/CBU, etc). Cualquiera puede LEERLOS (la
    // tienda y el formulario de revendedores los necesitan sin login),
    // pero solo vos (logueado como admin) podés cambiarlos.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sesiones de revendedores: cualquiera puede crear una (al
    // ingresar el código) y actualizar su propia actividad
    // (heartbeat). Solo el admin puede LEER la lista completa
    // o borrar registros.
    match /resellerSessions/{sessionId} {
      // Para crear una sesión hace falta mandar el código correcto Y,
      // si el admin cargó números autorizados (allowedPhones no está
      // vacía), que el teléfono normalizado (solo dígitos) esté en esa
      // lista. Si allowedPhones está vacía (todavía no se configuró),
      // no se exige esta segunda condición.
      allow create: if request.resource.data.code == resellerAccessData().code
        && (
          resellerAccessData().get('allowedPhones', []).size() == 0 ||
          request.resource.data.phoneNormalized in resellerAccessData().get('allowedPhones', [])
        )
        && !(request.resource.data.phoneNormalized in resellerAccessData().get('blockedPhones', []));
      allow update: if true;
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Pedidos de revendedores: se crea uno cada vez que un revendedor
    // completa el paso 2 del checkout (toca "Ya transferí"), siempre
    // como status "pending". Cualquiera puede crear (no requiere
    // login, igual que las sesiones), pero solo el admin puede leer la
    // lista completa, cambiar el status (confirmar/rechazar) o borrar.
    match /resellerOrders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Ranking competitivo de revendedores (Top 3 en revendedores.html),
    // por PLATA GENERADA en el mes calendario actual. Guarda SOLO el
    // nombre, el mes ("2026-08") y el monto acumulado — nunca datos
    // de compradores ni el detalle de cada pedido (eso vive aparte,
    // en resellerOrders, que es admin-only) — por eso puede ser de
    // lectura pública sin exponer información sensible. Se incrementa
    // desde el cliente (mismo criterio que resellerOrders/resellerSessions,
    // sin backend propio) cada vez que se confirma un pedido. El "id"
    // del documento incluye el mes, así que un mes nuevo arranca sus
    // propios totales en $0 sin que haga falta borrar nada a mano.
    match /resellerMonthlyStats/{statsId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Catálogo de productos (precios de la TIENDA original, los que
    // ve cualquier visitante en index.html). Lectura pública porque
    // la tienda necesita mostrarlos sin login. Solo el admin logueado
    // puede crear/editar/borrar productos.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Precios de REVENDEDORES, en una colección aparte (mismo ID que
    // el producto en /products) para que nunca se mezclen con los
    // precios de la tienda original. IMPORTANTE: como el acceso de
    // revendedores no usa Firebase Auth (solo un código verificado
    // desde el cliente, igual que /settings/resellerAccess), esta
    // colección es técnicamente de lectura pública — cualquiera que
    // consulte la API de Firestore directamente podría leerla, aunque
    // en la web nunca se muestra sin pasar el código. Es el mismo
    // nivel de protección que ya tenía el código de acceso. Para una
    // separación 100% segura haría falta backend propio (Cloud
    // Functions) autenticando a cada revendedor.
    match /resellerPricing/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Catálogo de productos de la modalidad "Stock" para revendedores
    // (cargas limitadas, una unidad por carga según disponibilidad).
    // Vive en su propia colección, separada de "products", porque acá
    // el precio ya es el final de revendedor (no hay precio de tienda
    // asociado). Mismo criterio de acceso que resellerPricing: lectura
    // pública (la página de revendedores la necesita sin login), solo
    // el admin puede escribir.
    match /resellerStockProducts/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
